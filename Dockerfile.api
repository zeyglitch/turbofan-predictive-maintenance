# The prediction API: FastAPI and the champion model, processor-only torch.
FROM python:3.13-slim

# no .pyc files in the image, and logs printed at once instead of being buffered
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

# the libraries first: this layer is rebuilt only when the list changes, not at each code change
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY params.yaml .
COPY turbofan/ turbofan/
COPY api/ api/

# run as an ordinary user rather than root
RUN useradd --create-home app
USER app

# the model is not in the image: docker-compose.yml mounts models/champion here
ENV MODEL_DIR=/app/models/champion
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
